# Copier ce fichier en .env (jamais committé) et adapter les valeurs.

# Clé de signature des cookies de session Flask du fetcher — générer une
# valeur aléatoire une fois (ex. `openssl rand -hex 32`), ne jamais commit
# la vraie valeur.
FETCHER_SECRET_KEY=change-me

# true (défaut) une fois le fetcher accessible via
# https://music-jvince.duckdns.org/fetcher (edge branché). Mettre à false
# UNIQUEMENT pour tester en HTTP direct (http://<IP>:8088) avant
# l'intégration edge — sinon la connexion échoue silencieusement (le cookie
# de session n'est jamais renvoyé par le navigateur sur une connexion
# non-HTTPS).
FETCHER_COOKIE_SECURE=true
