# Copier ce fichier en .env (jamais committé — cf. .gitignore racine) et
# compléter les valeurs.

# Clé secrète interne d'outline (sessions, chiffrement des tokens
# d'intégration...) — générer une fois, ne jamais réutiliser d'un
# environnement à l'autre :
#   openssl rand -hex 32
OUTLINE_SECRET_KEY=

# Utilisée pour chiffrer certaines valeurs sensibles en base (clés API des
# intégrations...) — même commande, valeur distincte de SECRET_KEY :
#   openssl rand -hex 32
OUTLINE_UTILS_SECRET=

# Mot de passe Postgres dédié à ce service (pas partagé, pas réutilisé) :
#   openssl rand -base64 36
OUTLINE_PG_PASSWORD=

# Secret du client OIDC "outline" déclaré côté authentik
# (authentik/provisioning/oidc-outline.yaml, OIDC_OUTLINE_CLIENT_SECRET côté
# authentik/.env) — même valeur des deux côtés :
#   openssl rand -hex 32
OIDC_OUTLINE_CLIENT_SECRET=
