# Copier ce fichier en .env (jamais committé) et adapter les valeurs.

# Adresse MAC de l'Optiplex (celle de l'interface filaire/wifi qui doit
# rester alimentée en veille pour recevoir le magic packet — vérifier le
# support WoL de l'interface visée, souvent uniquement l'Ethernet). Formats
# acceptés : "AA:BB:CC:DD:EE:FF" ou "AA-BB-CC-DD-EE-FF".
WOL_TARGET_MAC=

# Adresse de broadcast du réseau local où vit l'Optiplex. 255.255.255.255
# suffit tant que le conteneur tourne bien en network_mode: host sur le même
# segment L2 que l'Optiplex (cas par défaut ici, cf. CLAUDE.md).
WOL_BROADCAST_ADDR=255.255.255.255

# Jeton d'authentification du endpoint POST /wake (header
# "Authorization: Bearer <token>"). Générer une valeur longue et aléatoire,
# ex. : openssl rand -hex 32
WOL_AUTH_TOKEN=
