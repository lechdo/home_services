# Copier ce fichier en .env (jamais committé) et adapter les valeurs.

# Mot de passe PostgreSQL interne à ce service (jamais partagé avec un autre
# service, cf. CLAUDE.md racine). Générer une valeur forte, ex: openssl rand -base64 32
POSTGRES_PASSWORD=42CdNq138gSkPqQaZxlB1fMmLZLZslWDYlFTy33nfY

# Clé secrète Paperless-ngx (sessions, signature de données sensibles).
# Générer une valeur forte, ex: openssl rand -base64 48
PAPERLESS_SECRET_KEY=od1GABxs5CkmqfeY3hWF1l9R1Q1QbzsB6o9Z6Q8FsC0NIVaCNu1bTXYQ2d54R1S

# Superutilisateur créé automatiquement au premier démarrage.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=mWoTJBNfMp8tXjgHPeB65drX9vGBo9qJ
PAPERLESS_ADMIN_MAIL=admin@example.com

# Nom d'hôte externe (vu par les clients). Alimente PAPERLESS_URL, qui règle
# à la fois ALLOWED_HOSTS, CORS_ALLOWED_HOSTS et CSRF_TRUSTED_ORIGINS côté
# Paperless-ngx. Le DNS et le certificat TLS pour ce nom sont gérés par le
# service `edge`, jamais ici (cf. CLAUDE.md, section "Exposition Internet").
# En local sans edge (test isolé de ce service) : un nom en .test suffit
# (TLD réservé aux tests, RFC 2606), ex. paperless.home.test.
PUBLIC_HOSTNAME=paperless-jvince.duckdns.org

# Fuseau horaire de l'application (dates affichées, tâches planifiées).
PAPERLESS_TIME_ZONE=Europe/Paris

# Synchronisation unidirectionnelle Google Drive -> consume (Phase 1, cf.
# _plan/plan.md). Chemin rclone du dossier source dédié.
GDRIVE_REMOTE_PATH=gdrive:controlled_chaos
# rclone.conf pas encore en place (cf. scripts/authorize-gdrive.sh) :
# COMPOSE_PROFILES=gdrive-sync
