# Copier ce fichier en .env (jamais committé — cf. .gitignore racine) et
# compléter les valeurs.

# Clé secrète interne d'authentik (sessions, tokens...) — générer une fois,
# ne jamais réutiliser d'un environnement à l'autre :
#   openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# Mot de passe Postgres dédié à ce service (pas partagé, pas réutilisé) :
#   openssl rand -base64 36
AUTHENTIK_PG_PASSWORD=

# Secrets des clients OIDC référencés par les blueprints via !Env
# (provisioning/oidc-*.yaml) — même valeur à reporter dans le .env du
# service correspondant. Générer avec :
#   openssl rand -hex 32
OIDC_VIKUNJA_CLIENT_SECRET=
OIDC_PAPERLESS_CLIENT_SECRET=
OIDC_ACTUAL_CLIENT_SECRET=
OIDC_OUTLINE_CLIENT_SECRET=
