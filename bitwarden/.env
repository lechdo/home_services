# Copier ce fichier en .env (jamais committé) et adapter les valeurs.

# Nom de domaine externe (vu par les clients : navigateur, apps). Le DNS et le
# certificat TLS pour ce nom sont désormais gérés par le service `edge`, pas
# ici (cf. _plan/plan-migration-edge.md) — cette valeur ne sert plus qu'à
# construire DOMAIN pour vaultwarden (WebAuthn, URLs générées).
LOCAL_HOSTNAME=jvince.duckdns.org

# Token admin du panneau /admin de Vaultwarden. Générer une valeur forte, ex: openssl rand -base64 48
# En Phase A un token en clair suffit ; il devra être remplacé par un hash Argon2 avant la Phase C (durcissement).
ADMIN_TOKEN=1RTXHbF1btNz6mMkvaTgmHk8i09j1U7m2wJng78FL5B4FUoFq2bVL7QtosJ

# true en Phase A (création des 2-3 comptes) ; repasser à false une fois les comptes créés.
SIGNUPS_ALLOWED=false

# Sauvegarde chiffrée quotidienne (restic + rclone vers Google Drive), cf.
# _plan/plan-sauvegarde.md. RESTIC_PASSWORD généré le 2026-08-12 — déjà copié
# ailleurs par l'utilisateur en dehors de cette machine (sinon : le faire
# maintenant, avant le premier backup réel — perdu = sauvegardes irrécupérables).
RESTIC_REPOSITORY=rclone:gdrive:vaultwarden-backups
RESTIC_PASSWORD=7Lz1ic7m+unkghuxuNqTdoarj8ZeGyba5uhm2rB1dVo=
# COMPOSE_PROFILES=backup encore en commentaire : décommenter une fois
# rclone.conf en place (cf. _plan/plan-sauvegarde.md §2).
