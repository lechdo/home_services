# Chemin ABSOLU de ce dossier (minecraft/) sur la machine qui exécute
# Docker (le second serveur physique, 192.168.1.109) — pas un chemin relatif,
# pas un chemin vu depuis l'intérieur d'un conteneur. Exemple si ce dépôt est
# cloné dans /opt/home_services sur cette machine :
HOST_PROJECT_DIR=/opt/home_services/minecraft

# IP LAN de la machine qui héberge ce service — doit correspondre à l'hôte
# réel (second serveur physique, cf. minecraft/CLAUDE.md).
MC_LAN_IP=192.168.1.109

# Mémoire allouée au serveur Paper (voir MEMORY, image itzg/minecraft-server).
# 64 Go de RAM disponibles sur l'hôte au 2026-08-17 : 6G laisse une large
# marge pour paperless/actual-budget déjà présents sur la même machine.
MC_MEMORY=6G

# Clé de signature des cookies de session Flask du panel — générer une
# valeur aléatoire une fois (ex. `openssl rand -hex 32`), ne jamais commit
# la vraie valeur (ce fichier est un modèle, .env est gitignored).
PANEL_SECRET_KEY=change-me
